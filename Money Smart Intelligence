// 2. SCALE & MARKET REGIME CALCULATIONS
//=============================================================================
isBtcActive = assetMode == "BTCUSD (Bitcoin)" or (assetMode == "Auto Detect" and (str.contains(str.upper(syminfo.ticker), "BTC") or str.contains(str.upper(syminfo.ticker), "BITCOIN")))
isCustom    = assetMode == "Custom Manual"

ptVal       = pointSize > 0 ? pointSize : syminfo.mintick

effTp1Pts   = isCustom ? tp1Pts : (isBtcActive ? 15000.0 : tp1Pts)
effTp2Pts   = isCustom ? tp2Pts : (isBtcActive ? 30000.0 : tp2Pts)
effSlPts    = isCustom ? slPts  : (isBtcActive ? 30000.0 : slPts)
effE2Dist   = isCustom ? entry2Dist : (isBtcActive ? 15000.0 : entry2Dist)
effMinDist  = isCustom ? float(minDistPts) : (isBtcActive ? 8000.0 : float(minDistPts))
effFlipDist = isCustom ? float(flipDistPts) : (isBtcActive ? 4000.0 : float(flipDistPts))
effSpread   = isCustom ? spreadPts : (isBtcActive ? spreadPts * 30.0 : spreadPts)

tp1Val      = effTp1Pts * ptVal
tp2Val      = effTp2Pts * ptVal
e2Val       = effE2Dist * ptVal
slVal       = effSlPts * ptVal
minDistVal  = effMinDist * ptVal
flipDistVal = effFlipDist * ptVal

curLineStyle = lineStyleOpt == "Dashed" ? line.style_dashed : lineStyleOpt == "Dotted" ? line.style_dotted : line.style_solid
isInstantTouch = entryTriggerMode == "Instant Touch (Limit Style)"

atrVal  = ta.atr(14)
atrRef  = nz(atrVal[1], atrVal)

isHugeBearCandle = (open - close) > (2.0 * atrRef)
isHugeBullCandle = (close - open) > (2.0 * atrRef)

emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
trendFiltThresh = trendAtrMult * atrRef
distEma      = close - emaSlow
isStrongBull = distEma > trendFiltThresh
isStrongBear = distEma < -trendFiltThresh
canBuyTrend  = not (enableTrendFilter and isStrongBear)
canSellTrend = not (enableTrendFilter and isStrongBull)

isSpikeNews   = (high - low) > 2.2 * atrRef
isStrongTrend = math.abs(emaFast - emaSlow) > atrRef and math.abs(distEma) > trendFiltThresh

string marketRegimeTxt = "NORMAL (SAFE)"
color  marketRegimeCol = color.green
if isSpikeNews
    marketRegimeTxt := "NEWS / SPIKE ALERT"
    marketRegimeCol := color.red
else if isStrongTrend
    marketRegimeTxt := (close > emaSlow ? "STRONG BULL (SELL CAUTION)" : "STRONG BEAR (BUY CAUTION)")
    marketRegimeCol := color.red

