// 3. TRADING-DAY / WEEK / MONTH CALENDAR (SHIFTED BY RESET HOUR)
//=============================================================================
tradeTs         = time - resetHour * 3600000
curTradingMonth = month(tradeTs, tzInput)
curTradingDay   = dayofmonth(tradeTs, tzInput)
curTradingDow   = dayofweek(tradeTs, tzInput)
curYearT        = year(tradeTs, tzInput)
curHour         = hour(time, tzInput)

curMonthId = curYearT * 100 + curTradingMonth
curDayKey  = curMonthId * 100 + curTradingDay

int dow0      = (curTradingDow + 5) % 7        // Mon = 0 ... Sun = 6
int curDowIdx = dow0 <= 4 ? dow0 : (dow0 == 6 ? 0 : 4)

weekAnchor = dow0 == 6 ? tradeTs + 86400000 : tradeTs - dow0 * 86400000   // Monday of the trading week
curWeekId  = year(weekAnchor, tzInput) * 10000 + month(weekAnchor, tzInput) * 100 + dayofmonth(weekAnchor, tzInput)

firstDowOfMonth = ((dow0 - (curTradingDay - 1)) % 7 + 7) % 7
int curWeekOfMonth = math.min(4, math.max(0, math.floor((curTradingDay - 1 + firstDowOfMonth) / 7)))

nowTs      = timenow - resetHour * 3600000
nowDow0    = (dayofweek(nowTs, tzInput) + 5) % 7
nowAnchor  = nowDow0 == 6 ? nowTs + 86400000 : nowTs - nowDow0 * 86400000
nowWeekId  = year(nowAnchor, tzInput) * 10000 + month(nowAnchor, tzInput) * 100 + dayofmonth(nowAnchor, tzInput)
isWeekendNow = not isBtcActive and nowDow0 >= 5

isAllowedBar = (recordScope == "All Chart History") or (recordScope == "From Date (Input)" and time >= startTs) or (recordScope == "This Week (Mon - Fri)" and curWeekId == nowWeekId)

monthChg = ta.change(curMonthId) != 0
weekChg  = ta.change(curWeekId) != 0
dayChg   = ta.change(curDayKey) != 0

var array<int> allMonthIds = array.new<int>(0)
if bar_index == 0 or monthChg
    allMonthIds.push(curMonthId)

var array<int> allWeekIds = array.new<int>(0)
if bar_index == 0 or weekChg
    allWeekIds.push(curWeekId)

var int prevDayKey = na
prevBarDayKey = curDayKey[1]
if dayChg and not na(prevBarDayKey)
    prevDayKey := prevBarDayKey

var float dayHigh = na
var float dayLow  = na
if dayChg or na(dayHigh)
    dayHigh := high
    dayLow  := low
else
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow, low)

goldDayRangePts = math.round((dayHigh - dayLow) / ptVal)

goldSession    = (curHour >= 19 or curHour < 4) ? "NEW YORK" : (curHour >= 13 and curHour < 19) ? "LONDON" : "ASIA / TOKYO"
goldSessionCol = goldSession == "NEW YORK" ? color.green : goldSession == "LONDON" ? color.new(#00e5ff, 0) : color.white

//=============================================================================
// 4. SUPPORT & RESISTANCE WITH FLIP LOGIC
//=============================================================================
type SnRLevel
    float p
    bool  isSup
    int   lastUsedBar
    bool  isTriggered
    line  ln
    label lb

var array<SnRLevel> snrList = array.new<SnRLevel>(0)

ph = ta.pivothigh(high, pivotDepth, pivotDepth)
pl = ta.pivotlow(low, pivotDepth, pivotDepth)

f_addLevel(float price, bool isSupport) =>
    bool tooClose = false
    if snrList.size() > 0
        for i = 0 to snrList.size() - 1
            if math.abs(snrList.get(i).p - price) < minDistVal
                tooClose := true
                break
    if not tooClose
        line l = na
        label b = na
        if showSnRLines
            l := line.new(bar_index - pivotDepth, price, bar_index + 10, price, color = isSupport ? colSup : colRes, width = 1, style = line.style_solid)
        if showLabels
            b := label.new(bar_index, price, (isSupport ? "SUP " : "RES ") + str.tostring(price, "#.##"), color = color.new(color.black, 100), textcolor = isSupport ? colSup : colRes, style = label.style_none, size = size.tiny)
        snrList.unshift(SnRLevel.new(price, isSupport, -999, false, l, b))
        if snrList.size() > maxLines
            old = snrList.pop()
            if not na(old.ln)
                line.delete(old.ln)
            if not na(old.lb)
                label.delete(old.lb)

if not na(ph)
    f_addLevel(ph, false)
if not na(pl)
    f_addLevel(pl, true)

if snrList.size() > 0
    for i = 0 to snrList.size() - 1
        item = snrList.get(i)
        if enableFlip
            if item.isSup and close < (item.p - flipDistVal)
                item.isSup := false
                item.isTriggered := false
                if not na(item.ln)
                    line.set_color(item.ln, colRes)
                if not na(item.lb)
                    label.set_textcolor(item.lb, colRes)
                    label.set_text(item.lb, "RES (FLIP) " + str.tostring(item.p, "#.##"))
            else if not item.isSup and close > (item.p + flipDistVal)
                item.isSup := true
                item.isTriggered := false
                if not na(item.ln)
                    line.set_color(item.ln, colSup)
                if not na(item.lb)
                    label.set_textcolor(item.lb, colSup)
                    label.set_text(item.lb, "SUP (FLIP) " + str.tostring(item.p, "#.##"))
        if not na(item.ln)
            line.set_x2(item.ln, bar_index + 10)
        if not na(item.lb)
            label.set_x(item.lb, bar_index + 2)

f_cleanOldLines() =>
    if snrList.size() > 0
        for i = snrList.size() - 1 to 0
            item = snrList.get(i)
            if item.lastUsedBar > 0 and bar_index - item.lastUsedBar > 500
                snrList.remove(i)
                if not na(item.ln)
                    line.delete(item.ln)
                if not na(item.lb)
                    label.delete(item.lb)

if bar_index % 50 == 0
    f_cleanOldLines()

